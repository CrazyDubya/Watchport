# Watchport gateway stays loopback-only. Publish it with Tailscale Serve.
WATCHPORT_HOST=127.0.0.1
WATCHPORT_PORT=8443
WATCHPORT_ORIGIN=https://desktop.example-tailnet.ts.net:8443
WATCHPORT_RP_ID=desktop.example-tailnet.ts.net
WATCHPORT_COOKIE_SECURE=true
WATCHPORT_DATA_DIR=~/.watchport

# Generate a unique value, e.g. Python: secrets.token_urlsafe(32)
WATCHPORT_INDICATOR_SECRET=replace-with-at-least-24-random-characters
WATCHPORT_INDICATOR_TIMEOUT=6
WATCHPORT_VIEWER_HEARTBEAT_TIMEOUT=12
WATCHPORT_SESSION_TTL=900
WATCHPORT_ADMISSION_TTL=60

# Moonlight-Web control plane. Keep this loopback-only.
WATCHPORT_MOONLIGHT_ORIGIN=https://127.0.0.1
WATCHPORT_MOONLIGHT_VERIFY_TLS=false

# Browser-facing Moonlight-Web origin. MUST use the exact same hostname as
# WATCHPORT_ORIGIN; cookies are host-scoped even though the port differs.
WATCHPORT_STREAM_ORIGIN=https://desktop.example-tailnet.ts.net

# Watchport exclusively owns Moonlight-Web player slots 2..4.
WATCHPORT_MOONLIGHT_SLOTS=2,3,4
WATCHPORT_MOONLIGHT_TTL=3600

# Fill these after `watchport-doctor` identifies the paired Sunshine host/app.
WATCHPORT_MOONLIGHT_HOST_UUID=
WATCHPORT_MOONLIGHT_APP_ID=-1

# Host-side indicator talks back to the loopback gateway.
WATCHPORT_LOCAL_URL=http://127.0.0.1:8443
