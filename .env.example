# Bind to localhost by default. Use a Tailscale address only after HTTPS is configured.
WATCHPORT_HOST=127.0.0.1
WATCHPORT_PORT=8443
WATCHPORT_ORIGIN=https://watchport.example-tailnet.ts.net:8443
WATCHPORT_RP_ID=watchport.example-tailnet.ts.net
WATCHPORT_COOKIE_SECURE=true
WATCHPORT_INDICATOR_SECRET=replace-with-a-long-random-secret

# V1 adapter: use ONLY a Moonlight-Web backend-enforced Viewer invitation URL.
# Never configure a normal/full-control Moonlight-Web URL here.
WATCHPORT_VIEWER_URL=https://your-moonlight-web-viewer-url

# Host-side indicator talks back to this local address.
WATCHPORT_LOCAL_URL=http://127.0.0.1:8443
